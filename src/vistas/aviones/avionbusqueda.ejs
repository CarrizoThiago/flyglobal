<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../../styles/index.css">
    <link rel="stylesheet" href="../../styles/button.css">
    <link rel="stylesheet" href="../../styles/banner.css">
    <link rel="stylesheet" href="../../styles/panel.css">
    <link rel="stylesheet" href="../../styles/tabla.css">
</head>

<body>
    <div class="container">
        <header>
            <h1>Busqueda de Aviones</h1>
        </header>
        <a href="/avion">
            <button class="bvolver">Volver al Menu</button>
        </a>
        <form action="/avionsearch" method="post">
            <table>
                <tr>
                    <td class="tdlabel">
                        <label for="matricula">Matricula:</label>
                    </td>
                    <td class="tdinput">
                        <input type="text" name="matriculahtml" id="matricula">
                    </td>
                </tr>
                <tr>
                    <td class="tdbutton" colspan="2">
                        <button type="submit" class="bb">Buscar</button>
                    </td>
                </tr>
            </table>
        </form>
        <%if(muestro){ if(encontrado){%>
            <div class="ppos">
                <p>Avion encontrado.</p>
                <table>
                    <thead>
                        <tr>
                            <th>Matricula</th>
                            <th>Modelo</th>
                            <th>Capacidad</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="tdpar">
                            <td>
                                <%=registro[0].matricula%>
                            </td>
                            <td>
                                <%=registro[0].modelo%>
                            </td>
                            <td>
                                <%=registro[0].capacidad%>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <%if(registro2.length> 0){%>
                    <p>Vuelos con este avion:</p>
                    <table>
                        <thead>
                            <th>IDvuelo</th>
                            <th>Numero de vuelo</th>
                            <th>Origen</th>
                            <th>Destino</th>
                            <th>Fecha de salida</th>
                            <th>Fecha de llegada</th>
                        </thead>
                        <tbody>
                            <%for(let i=0; i<registro2.length;i++){%>
                                <tr <%if( i%2==0){%> class="tdpar"<%}else{%>class="tdimpar"<%}%> >
                                            <td>
                                                <%=registro2[i].idvuelo%>
                                            </td>
                                            <td>
                                                <%=registro2[i].numerovuelo%>
                                            </td>
                                            <td>
                                                <%=registro2[i].aeropuerto_codigoiata_origen%>
                                            </td>
                                            <td>
                                                <%=registro2[i].aeropuerto_codigoiata_destino%>
                                            </td>
                                            <td>
                                                <%=registro2[i].fecha_salida%>
                                            </td>
                                            <td>
                                                <%=registro2[i].fecha_llegada%>
                                            </td>
                                </tr>
                                <%}%>
                        </tbody>
                    </table>
                    <%}%>


            </div>
            <%}else{%>
                <div class="pneg">
                    <p>No se encontro el avion con la matricula
                        <%=matricula%>
                    </p>
                </div>
                <%}%>
                    <%}%>
    </div>

</body>

</html>