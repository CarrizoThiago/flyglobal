<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../../styles/index.css">
    <link rel="stylesheet" href="../../styles/button.css">
    <link rel="stylesheet" href="../../styles/tabla.css">
    <link rel="stylesheet" href="../../styles/panel.css">

</head>

<body>
    <div class="container">
        <header>
            <h1>Ver todos los Aviones</h1>
        </header>
        <a href="/avion">
            <button class="bvolver">Volver al menu</button>
        </a>
        <form action="/avionactualizado" method="post">
            <input type="hidden" name="minhtml" value="0">
            <input type="hidden" name="maxhtml" value="15">
            <table>
                <tr>
                    <td class="tdlabel">
                        <label for="buscarxhtml">Buscar:</label>
                    </td>
                    <td class="tdinput">
                        <select name="buscarxhtml">
                            <option value="">Todos</option>
                            <option value="100">Menos de 100 pasajeros</option>
                            <option value="200">Menos de 200 pasajeros</option>
                            <option value="300">Mas de 200 pasajeros</option>
                        </select>
                    </td>
                </tr>

                <td colspan="2" class="tdbutton">
                    <button type="submit" class="bb">Actualizar</button>
                </td>

            </table>

        </form>
        <%if(registro!=null && registro.length==0){%>
            <div class="pneg">
                <p>No se encontro ningun avion.</p>
            </div>
            <%}else if(registro!=null && registro.length>0){%>
                <table>
                    <thead>
                        <tr>
                            <th>Matricula</th>
                            <th>Modelo</th>
                            <th>Capacidad</th>
                        </tr>
                    </thead>
                    <tbody>
                        <%for(let i=min;i<registro.length && i<max;i++) {%>
                            <tr <% if(i%2==0){%> class="tdpar" <%}else{%> class="tdimpar" <%}%> >
                                        <td>
                                            <%= registro[i].matricula %>
                                        </td>
                                        <td>
                                            <%= registro[i].modelo %>
                                        </td>
                                        <td>
                                            <%= registro[i].capacidad %>
                                        </td>
                            </tr>
                            <%}%>
                    </tbody>
                </table>
                <%if(registro.length>max){%>
                    <form action="/avionactualizado" method="post">
                        <input type="hidden" name="buscarxhtml" value="<%=buscarx%>">
                        <input type="hidden" name="minhtml" value="<%=min + 15%>">
                        <input type="hidden" name="maxhtml" value="<%=max + 15%>">
                        <button type="submit" class="bb">Siguiente -></button>
                    </form>
                    <%}%>
                        <%if(min> 0){%>
                            <form action="/avionactualizado" method="post">
                                <input type="hidden" name="buscarxhtml" value="<%=buscarx%>">
                                <input type="hidden" name="minhtml" value="<%=min - 15%>">
                                <input type="hidden" name="maxhtml" value="<%=max - 15%>">
                                <button type="submit" class="bb"><- Anterior</button>
                            </form>
                            <%}%>
                                <%}else{%>
                                    <div class="pneg">
                                        <p>Error al obtener los registros de aviones.</p>
                                    </div>
                                    <%}%>
    </div>

</body>

</html>