<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../../styles/index.css">
    <link rel="stylesheet" href="../../styles/tabla.css">
    <link rel="stylesheet" href="../../styles/button.css">
    <link rel="stylesheet" href="../../styles/panel.css">

</head>

<body>
    <div class="container">
        <header>
            <h1>Vuelo ver todo.</h1>
        </header>
        <nav>
            <a href="/vuelo">
                <button class="bvolver">volver al menu</button>
            </a>
        </nav>
        <form action="/vueloactualizado" method="post">
            <input type="hidden" name="minhtml" value="<%= 0 %>">
            <input type="hidden" name="maxhtml" value="<%= 15 %>">
            <table>
                <tr>
                    <td class="tdlabel">
                        <label for="buscarxhtml">Buscar por:</label>
                    </td>
                    <td class="tdinput">
                        <select name="buscarxhtml">
                            <option value="">Ver todos los Vuelos</option>
                            <option value="ARG">Ver solo Vuelos de Nacionales</option>
                            <option value="INT">Ver solo Vuelos Internacionales</option>
                            <option value="V">Ver solo Vuelos vigentes</option>
                            <option value="NV">Ver solo Vuelos no vigentes</option>
                            <option value="L">Ver solo Vuelos llenos</option>
                            <option value="NL">Ver solo Vuelos x llenar</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <td colspan="2" class="tdbutton">
                        <button class="bmove" type="submit">Actualizar</button>
                    </td>
                </tr>
            </table>
        </form>

        <%if(muestro==true){%>
            <%if(registros!=null && registros.length>0){%>
                <table>
                    <thead>
                        <tr>
                            <th>IDvuelo</th>
                            <th>Numero de vuelo</th>
                            <th>IATA de origen</th>
                            <th>IATA de destino</th>
                            <th>Fecha de salida</th>
                            <th>Fecha de llegada</th>
                            <th>Matricula del Avion</th>
                        </tr>
                    </thead>
                    <tbody>
                        <%for(let i=min;i<registros.length && i < max;i++){%>
                            <tr<%if(i%2==0) {%> class="tdpar"<% }else{%> class="tdimpar"<% }%> >
                                        <td>
                                            <%=registros[i].idvuelo%>
                                        </td>
                                        <td>
                                            <%=registros[i].numerovuelo%>
                                        </td>
                                        <td>
                                            <%=registros[i].aeropuerto_codigoiata_origen%>
                                        </td>
                                        <td>
                                            <%=registros[i].aeropuerto_codigoiata_destino%>
                                        </td>
                                        <td>
                                            <%=registros[i].fecha_salida%>
                                        </td>
                                        <td>
                                            <%=registros[i].fecha_llegada%>
                                        </td>
                                        <td>
                                            <%=registros[i].avion_matricula%>
                                        </td>
                                        </tr>
                                        <%}%>
                    </tbody>
                </table>
                <% if(registros.length>max){%>
                    <form action="/vueloactualizado" method="post">
                        <input type="hidden" name="minhtml" value="<%=min+15 %>">
                        <input type="hidden" name="maxhtml" value="<%=max+15 %>">
                        <input type="hidden" name="buscarxhtml" value="<%= buscarx %>">
                        <button class="bmove" type="submit">Siguiente -></button>
                    </form>
                    <% } %>
                        <% if(min> 0){%>
                            <form action="/vueloactualizado" method="post">
                                <input type="hidden" name="minhtml" value="<%=min-15 %>">
                                <input type="hidden" name="maxhtml" value="<%=max-15 %>">
                                <input type="hidden" name="buscarxhtml" value="<%= buscarx %>">
                                <button class="bmove" type="submit"><- Anterior </button>
                            </form>
                            <% } %>
                                <%}else if(registros!=null && registros.length==0){%>
                                    <div class="pneg">
                                        <p>No hay registros</p>
                                    </div>
                                    <%}else if(registros==null){%>
                                        <div class="pneg">
                                            <p>Error al obtener los registros</p>
                                        </div>
                                        <% }}%>






    </div>

</body>

</html>