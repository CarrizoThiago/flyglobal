<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../../styles/index.css">
    <link rel="stylesheet" href="../../styles/button.css">
    <link rel="stylesheet" href="../../styles/panel.css">
    <link rel="stylesheet" href="../../styles/tabla.css">
</head>

<body>
    <div class="container">
        <header>
            <h1>Usuario busqueda.</h1>
        </header>
        <nav>
            <a href="/usuario">
                <button class="bvolver">volver al menu</button>
            </a>
        </nav>
        <form action="/usuariosearch" method="post">
            <table>
                <tr>
                    <td class="tdlabel">
                        <label for="idhtml">Id:</label>
                    </td>
                    <td class="tdinput">
                        <input type="text" name="idhtml" placeholder="id">
                    </td>
                </tr>
                <tr>
                    <td class="tdbutton" colspan="2">
                        <button type="submit" class="bb">Buscar</button>
                    </td>
                </tr>
            </table>
        </form>
        <% if( muestro==true ){ if(exito==false){ %>
            <div class="pneg">
                <p>No se encontro el usuario.</p>
            </div>
            <% }else{if (registros.length>0){ %>
                <div class="ppos">
                    <table>
                        <thead>
                            <tr>
                                <th>id</th>
                                <th>pasaporte</th>
                                <th>nombre</th>
                                <th>apellido</th>
                                <th>email</th>
                                <th>telefono</th>
                                <th>contraseña</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="tdpar">
                                <td>
                                    <%=registros[0].idusuario %>
                                </td>
                                <td>
                                    <%=registros[0].pasaporte %>
                                </td>
                                <td>
                                    <%=registros[0].nombre %>
                                </td>
                                <td>
                                    <%=registros[0].apellido %>
                                </td>
                                <td>
                                    <%=registros[0].email %>
                                </td>
                                <td>
                                    <%=registros[0].telefono %>
                                </td>
                                <td>
                                    <%if(registros[0].contraseña !=null && registros[0].contraseña !="" ){%>
                                        <%=registros[0].contraseña %>
                                            <%}else{%>Usuario sin contraseña.
                                                <%}%>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <%}else{ %>
                        <div class="pneg">
                            <p>No se encontro un usuario con ese id.</p>
                        </div>
                        <%}} if(err==true){%>
                            <div class="pneg">
                                <p>No se pudo ejecutar la query.</p>
                            </div>
                            <%}}else{%>
                                <div class="pneu">
                                    <p>Nose a buscado algo aun.</p>
                                </div>
                                <%}%>
                </div>

</body>

</html>