<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../styles/index.css">
    <link rel="stylesheet" href="../../styles/button.css">
    <link rel="stylesheet" href="../../styles/panel.css">
    <link rel="stylesheet" href="../../styles/tabla.css">
</head>

<body>
    <div class="container">
        <header>
            <h1>Usuario alta.</h1>
        </header>
        <nav>
            <a href="/usuario">
                <button class="bvolver">volver al menu</button>
            </a>
        </nav>
        <form action="/usuarionuevo" method="post">
            <label for="idhtml">id:</label><input type="text" name="idhtml" placeholder="id"><br>
            <label for="pasaportehtml">Pasaporte:</label><input type="text" name="pasaportehtml"
                placeholder="pasaporte"><br>
            <label for="nombrehtml">Nombre:</label><input type="text" name="nombrehtml" placeholder="nombre"><br>
            <label for="apellidohtml">Apellido:</label><input type="text" name="apellidohtml"
                placeholder="apellido"><br>
            <label for="emailhtml">Email:</label><input type="text" name="emailhtml" placeholder="email"><br>
            <label for="telefonohtml">Telefono:</label><input type="text" name="telefonohtml"
                placeholder="telefono"><br>
            <label for="contraseñahtml">Contraseña:</label><input type="text" name="contraseñahtml"
                placeholder="contraseña"><br>
            <button type="submit" class="balta">Guardar</button>
        </form>
        <%if(muestro==true){ if(subido==true){%>
            <div class="ppos">
                <p>El usuario se agrego correctamente</p><br>
                <table>
                    <thead>
                        <tr>
                            <th>id</th>
                            <th>Pasaporte</th>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Email</th>
                            <th>Telefono</th>
                            <th>Contraseña</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="tdpar">
                            <td>
                                <%= id %>
                            </td>
                            <td>
                                <%= pasaporte %>
                            </td>
                            <td>
                                <%= nombre %>
                            </td>
                            <td>
                                <%= apellido %>
                            </td>
                            <td>
                                <%= email %>
                            </td>
                            <td>
                                <%= telefono %>
                            </td>
                            <%if(contraseña!=null){%>
                                <td>
                                    <%= contraseña %>
                                </td>
                                <%}else{%>
                                    <td>
                                        Usuario sin contraseña.
                                    </td>
                                    <%}%>
                        </tr>
                    </tbody>
                </table>
            </div>
            <%}else{%>
                <div class="pneg">
                    <p>No se pudo subir el regsitro.</p>
                </div>

                <div class="pneg">
                    <%if(conid==false){%>
                        <p>El id
                            es incorrecto. <br> Este debe tener un largo de entre 1 y 10 caracteres sin
                            caracteres especiales y/o numeros, ademas no puede ser nulo. <br> Arreglelo y subalo.
                        </p>
                        <%}%>
                            <%if(conpasaporte==false){%>
                                <p>El
                                    pasaporte es incorrecto.<br>Este debe tener
                                    un largo de entre 2 y 9 caracteres. <br> Arreglelo y subalo.</p>
                                <%}%>
                                    <%if(connom==false){%>
                                        <p>
                                            El nombre es incorrecto. <br> Este debe tener un largo de entre 2 y 30
                                            caracteres y no puede contener numeros ni caracteres especiales.</p>
                                        <%}%>
                                            <%if(conape==false){%>
                                                <p
                                                   >
                                                    El apellido es incorrecto. <br> Este debe tener un largo de entre 2
                                                    y 25 caracteres y no puede contener numeros ni caracteres
                                                    especiales.</p>
                                                <%}%>
                                                    <%if(conema==false){%>
                                                        <p
                                                           >
                                                            El email es incorrecto. <br> Este debe tener un largo de
                                                            entre 2 y 50
                                                            .</p>
                                                        <%}%>
                                                            <%if(contele==false){%>
                                                                <p
                                                                   >
                                                                    El telefono es incorrecto.<br>Este debe tener
                                                                    un largo de entre 2 y 20 caracteres. <br> Arreglelo
                                                                    y subalo.</p>
                                                                <%}%>
                                                                    <%if(concontra==false){%>
                                                                        <p
                                                                           >
                                                                            La contraseña es incorrecta.<br>Este debe
                                                                            tener
                                                                            un largo de entre 2 y 45 caracteres. <br>
                                                                            Arreglelo y subalo.</p>
                                                                        <%}%>
                </div>
                <%} } %>
    </div>
</body>

</html>