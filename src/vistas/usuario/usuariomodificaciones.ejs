<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../../styles/index.css">
    <link rel="stylesheet" href="../../styles/button.css">
    <link rel="stylesheet" href="../../styles/panel.css">
    <link rel="stylesheet" href="../../styles/tabla.css">
</head>

<body>
    <div class="container">
        <header>
            <h1>Usuario modificaciones</h1>
        </header>
        <nav>
            <a href="/usuario">
                <button class="bvolver">volver al menu</button>
            </a>
        </nav>
        <div class="pneu">
            <form action="/usuariomodificacionagarre" method="post">
                <table>
                    <tr>
                        <td class="tdlabel">
                            <label for="idhtml">ID: </label>
                        </td>
                        <td class="tdinput">
                            <input type="text" name="idhtml" id="idhtml">
                        </td>
                    </tr>
                    <tr>
                        <td class="tdbutton" colspan="2">
                            <button type="submit" class="bb">ubicar</button>
                        </td>
                    </tr>
                </table>
            </form>
        </div>
        <% if(muestro){if(encontrado){%>
            <div class="ppos">
                <p>Se encontro el usuario.</p> <br>

                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Pasaporte</th>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Email</th>
                            <th>Telefono</th>
                            <th>Contraseña</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <%= registros[0].idusuario %>
                            </td>
                            <td>
                                <%= registros[0].pasaporte %>
                            </td>
                            <td>
                                <%= registros[0].nombre %>
                            </td>
                            <td>
                                <%= registros[0].apellido %>
                            </td>
                            <td>
                                <%= registros[0].email %>
                            </td>
                            <td>
                                <%= registros[0].telefono %>
                            </td>
                            <td>
                                <%if(registros[0].contraseña !=null && registros[0].contraseña !="" ){%>
                                    <%=registros[0].contraseña %>
                                        <%}else{%>Usuario sin contraseña.
                                            <%}%>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <%if (muestro2){}else{ if (cambiado){}else{%>
                <div>
                    <p>Solo escriba los campos que quiera
                        modificar.
                    </p>
                    <form action="/usuariomodificacion" method="post">
                        <input type="hidden" name="idoriginal" value="<%= registros[0].idusuario %>">
                        <input type="hidden" name="pasaporteoriginal" value="<%= registros[0].pasaporte %>">
                        <input type="hidden" name="nombreoriginal" value="<%= registros[0].nombre %>">
                        <input type="hidden" name="apellidooriginal" value="<%= registros[0].apellido %>">
                        <input type="hidden" name="emailoriginal" value="<%= registros[0].email %>">
                        <input type="hidden" name="telefonoriginal" value="<%= registros[0].telefono %>">
                        <input type="hidden" name="contraseñoriginal" value="<%= registros[0].contraseña %>">
                        <table>
                            <tr>
                                <td class="tdlabel">
                                    <label for="idhtml2">ID: </label>
                                </td>
                                <td class="tdinput">
                                    <input type="text" name="idhtml2" id="idhtml2">
                                </td>
                            </tr>
                            <tr>
                                <td class="tdlabel">
                                    <label for="pasaportehtml">Pasaporte: </label>
                                </td>
                                <td class="tdinput">
                                    <input type="text" name="pasaportehtml" id="pasaportehtml">
                                </td>
                            </tr>
                            <tr>
                                <td class="tdlabel">
                                    <label for="nombrehtml">Nombre: </label>
                                </td>
                                <td class="tdinput">
                                    <input type="text" name="nombrehtml" id="nombrehtml">
                                </td>
                            </tr>
                            <tr>
                                <td class="tdlabel">
                                    <label for="apellidohtml">Apellido: </label>
                                </td>
                                <td class="tdinput">
                                    <input type="text" name="apellidohtml" id="apellidohtml">
                                </td>
                            </tr>
                            <tr>
                                <td class="tdlabel">
                                    <label for="emailhtml">Email: </label>
                                </td>
                                <td class="tdinput">
                                    <input type="text" name="emailhtml" id="emailhtml">
                                </td>
                            </tr>
                            <tr>
                                <td class="tdlabel">
                                    <label for="telefonohtml">Telefono: </label>
                                </td>
                                <td class="tdinput">
                                    <input type="text" name="telefonohtml" id="telefonohtml">
                                </td>
                            </tr>
                            <tr>
                                <td class="tdlabel">
                                    <label for="contraseñahtml">Contraseña: </label>
                                </td>
                                <td class="tdinput">
                                    <input type="text" name="contraseñahtml" id="contraseñahtml">
                                </td>
                            </tr>
                            <tr>
                                <td class="tdbutton" colspan="2">
                                    <button type="submit" class="balta">modificar</button>
                                </td>
                            </tr>
                        </table>
                    </form>
                </div>
                <%} }%>
                    <%}else{ %>
                        <div class="pneg">
                            <p>No se encontro el usuario.</p>
                        </div>
                        <%} }%>
                            <% if (muestro2){if(cambiado){%>
                                <div class="ppos">
                                    <p>Usuario modificado correctamente.</p>
                                    <table>
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Pasaporte</th>
                                                <th>Nombre</th>
                                                <th>Apellido</th>
                                                <th>Email</th>
                                                <th>Telefono</th>
                                                <th>Contraseña</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <%= registros2[0].idusuario %>
                                                </td>
                                                <td>
                                                    <%= registros2[0].pasaporte %>
                                                </td>
                                                <td>
                                                    <%= registros2[0].nombre %>
                                                </td>
                                                <td>
                                                    <%= registros2[0].apellido %>
                                                </td>
                                                <td>
                                                    <%= registros2[0].email %>
                                                </td>
                                                <td>
                                                    <%= registros2[0].telefono %>
                                                </td>
                                                <td>
                                                    <%if(registros2[0].contraseña !=null && registros2[0].contraseña !=""
                                                        ){%>
                                                        <%=registros2[0].contraseña %>
                                                            <%}else{%>Usuario sin contraseña.
                                                                <%}%>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <%}else{%>
                                    <div class="pneg">
                                        <p>Usuario no modificado.</p>
                                        <%if(conid==false){%>
                                            <p>
                                                El
                                                ID no es valido: <%= id %> debe tener un largo maximo de 10 digitos y
                                                    solo deben ser numeros.
                                            </p>
                                            <%}%>
                                                <%if(conpasaporte==false){%>
                                                    <p>
                                                        El pasaporte no es valido: <%= pasaporte %> puede tener de 2 a
                                                            9 letras y/o numeros.</p>
                                                    <%}%>
                                                        <%if(connom==false){%>
                                                            <p>
                                                                El nombre no es valido: <%= nombre %> puede tener un
                                                                    largo
                                                                    maximo de 30 caracteres.</p>
                                                            <%}%>
                                                                <%if(conape==false){%>
                                                                    <p>
                                                                        El apellido no es valido: <%= apellido %> puede
                                                                            tener
                                                                            un largo maximo de 25 caracteres.
                                                                    </p>
                                                                    <%}%>
                                                                        <%if(conema==false){%>
                                                                            <p>
                                                                                El email no es valido: <%= email %>
                                                                                    puede tener un
                                                                                    largo
                                                                                    maximo de 50 caracteres.</p>
                                                                            <%}%>

                                                                                <%if(contele==false){%>
                                                                                    <p>
                                                                                        El telefono no es
                                                                                        valido: <%= telefono %>
                                                                                            puede tener
                                                                                            un
                                                                                            largo
                                                                                            maximo de 20
                                                                                            caracteres y no
                                                                                            puede contener
                                                                                            letras.
                                                                                    </p>
                                                                                    <%}%>
                                                                                        <%if(concontra==false){%>
                                                                                            <p>
                                                                                                La contraseña no
                                                                                                es valida: <%=
                                                                                                    contraseña %>
                                                                                                    puede tener
                                                                                                    un largo
                                                                                                    maximo de 45
                                                                                                    caracteres.
                                                                                            </p>
                                                                                            <%}%>
                                    </div>
                                    <%} }%>
    </div>

</body>

</html>