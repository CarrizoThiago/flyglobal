<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../../styles/index.css">
    <link rel="stylesheet" href="../../styles/button.css">
    <link rel="stylesheet" href="../../styles/panel.css">
    <link rel="stylesheet" href="../../styles/tabla.css">
</head>

<body>
    <div class="container">
        <header>
            <h1>Aeropuerto busqueda.</h1>
        </header>
        <nav>
            <a href="/aeropuerto">
                <button class="bvolver">volver al menu</button>
            </a>
        </nav>
        <form action="/aeropuertosearch" method="post">
            <table>
                <tr>
                    <td class="tdlabel">
                        <label for="buscarxhtml">Buscar por:</label>
                    </td>
                    <td class="tdinput">
                        <select name="buscarxhtml">
                            <option value="codigoiata">Codigo IATA</option>
                            <option value="ciudad">Ciudad</option>
                            <option value="pais">Pais</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <td class="tdlabel">
                        <label for="inputhtml">Ingrese:</label>
                    </td>
                    <td class="tdinput">
                        <input type="text" name="inputhtml" placeholder="Busqueda...">
                    </td>
                </tr>
                <tr>
                    <td class="tdbutton" colspan="2">
                        <button type="submit" class="bb">Buscar</button>
                    </td>
                </tr>
            </table>
        </form>
        <% if( muestro==true ){ if(registros.length==0){ %>
            <div class="pneg">
                <p>No se encontro el aeropuerto.</p>
            </div>
            <% }else{ %>
                <div class="ppos">
                    <table>
                        <thead>
                            <tr>
                                <th>codigo iata</th>
                                <th>nombre</th>
                                <th>ciudad</th>
                                <th>pais</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for(let i=0; i<registros.length; i++){ %>
                                <tr <%if(i%2==0){%>class="tdpar"<%}else{%>class="tdimpar"<%}%>>
                                            <td>
                                                <%=registros[i].codigoiata %>
                                            </td>
                                            <td>
                                                <%=registros[i].nombre %>
                                            </td>
                                            <td>
                                                <%=registros[i].ciudad %>
                                            </td>
                                            <td>
                                                <%=registros[i].pais %>
                                            </td>
                                </tr>
                                <%}%>
                        </tbody>
                    </table>
                    <%} }else{%>
                        <div class="pneu">
                            <p>No se ha buscado nada aun.</p>
                        </div>
                        <%}%>
                </div>

</body>

</html>