<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../styles/index.css">
    <link rel="stylesheet" href="../../styles/button.css">
    <link rel="stylesheet" href="../../styles/panel.css">
    <link rel="stylesheet" href="../../styles/tabla.css">
</head>

<body>
    <div class="container">
        <header>
            <h1>Aeropuerto alta.</h1>
        </header>
        <nav>
            <a href="/aeropuerto">
                <button class="bvolver">volver al menu</button>
            </a>
        </nav>
        <form action="/aeropuertonuevo" method="post">
            <table>
                <tr>
                    <td class="tdlabel">
                        <label for="iatahmtl">Codigo IATA:</label>
                    </td>
                    <td class="tdinput">
                        <input type="text" name="iatahmtl" placeholder="codigo iata">
                    </td>
                </tr>
                <tr>
                    <td class="tdlabel">
                        <label for="nomhtml">Nombre:</label>
                    </td>
                    <td class="tdinput">
                        <input type="text" name="nomhtml" placeholder="nombre">
                    </td>
                </tr>
                <tr>
                    <td class="tdlabel">
                        <label for="ciuhtml">Ciudad:</label>
                    </td>
                    <td class="tdinput">
                        <input type="text" name="ciuhtml" placeholder="ciudad">
                    </td>
                </tr>
                <tr>
                    <td class="tdlabel">
                        <label for="paihtml">Pais:</label>
                    </td>
                    <td class="tdinput">
                        <input type="text" name="paihtml" placeholder="pais">
                    </td>
                </tr>
            </table>
            <button type="submit" class="balta">Guardar</button>
        </form>
        <%if(muestro==true){ if(subido==true){%>
            <div class="ppos">
                <p>El aueropuerto se agrego correctamente</p><br>
                <table>
                    <thead>
                        <tr>
                            <th>IATA</th>
                            <th>Nombre</th>
                            <th>Ciudad</th>
                            <th>Pais</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="tdpar">
                            <td>
                                <%= codigoiata %>
                            </td>
                            <td>
                                <%= nombre %>
                            </td>
                            <td>
                                <%= ciudad %>
                            </td>
                            <td>
                                <%= pais %>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <%}else{ if(err==true){%>
                <div class="pneg">
                    <p>No se pudo subir el regsitro.</p>
                </div>
                <%}else{ %>
                    <div class="pneg">
                        <%if(coniata==false){%>
                            <p>El codigo IATA
                                es incorrecto. <br> Este debe
                                tener un largo de 3 letras exactas sin
                                caracteres especiales y/o numeros, ademas no puede ser nulo. <br> Arreglelo y subalo.
                            </p>
                            <%}%>
                                <%if(connom==false){%>
                                    <p>El
                                        nombre es incorrecto.<br>Este debe tener
                                        un largo de entre 2 y 70 caracteres. <br> Arreglelo y subalo.</p>
                                    <%}%>
                                        <%if(conciu==false){%>
                                            <p>
                                                La ciudad es incorrecta. <br> Este debe tener un largo de entre 2 y 45
                                                caracteres y no puede contener numeros ni caracteres especiales.</p>
                                            <%}%>
                                                <%if(conpai==false){%>
                                                    <p>
                                                        El pais es incorrecto. <br> Este debe tener un largo de entre 2
                                                        y 45 caracteres y no puede contener numeros ni caracteres
                                                        especiales.</p>
                                                    <%}%>
                    </div>
                    <%}%>
                        <%}}%>
    </div>
</body>

</html>