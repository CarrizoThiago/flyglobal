<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../../styles/index.css">
    <link rel="stylesheet" href="../../styles/button.css">
    <link rel="stylesheet" href="../../styles/panel.css">
    <link rel="stylesheet" href="../../styles/tabla.css">
</head>

<body>
    <div class="container">
        <header>
            <h1>Aeropuerto baja.</h1>
        </header>
        <nav>
            <a href="/aeropuerto">
                <button class="bvolver">volver al menu</button>
            </a>
        </nav>
        <form action="/aeropuertodelete" method="post">
            <table>
                <tr>
                    <td class="tdlabel">
                        <label for="iatahtml">Codigo IATA:</label>
                    </td>
                    <td class="tdinput">
                        <input type="text" name="iatahtml" placeholder="codigo iata">
                    </td>
                </tr>
                <tr>
                    <td class="tdbutton" colspan="2">
                        <button type="submit" class="bbaja">Eliminar</button>
                    </td>
                </tr>
            </table>
        </form>

        <% if(muestro==true){if(exito==true){%>
            <div class="ppos">
                <p>El aeropuerto se elimino correctamente</p><br>
                <table>
                    <thead>
                        <tr>
                            <th>IATA</th>
                            <th>Nombre</th>
                            <th>Ciudad</th>
                            <th>Pais</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr class="tdpar">
                            <td>
                                <%= registros[0].codigoiata%>
                            </td>
                            <td>
                                <%= registros[0].nombre%>
                            </td>
                            <td>
                                <%= registros[0].ciudad%>
                            </td>
                            <td>
                                <%= registros[0].pais%>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <%}else{ if(registros2.length> 0){ %>
                <div class="pneg">
                    <p>No se pudo borrar el aeropuerto.</p><br>
                    <p>Para eliminarlo no tiene que haber vuelos asociados al mismo.</p><br>
                    <p>Vuelo asociados:</p>
                    <table>
                        <thead>
                            <tr>
                                <th>IDvuelo</th>
                                <th>Numero de vuelo</th>
                                <th>Fecha de salida</th>
                                <th>Origen</th>
                                <th>Destino</th>
                            </tr>
                        </thead>
                        <tbody>
                            <%for(let i=0;i<registros2.length;i++){%>
                                <tr <%if(i%2==0){%>class="tdpar"<%}else{%>class="tdimpar"<%}%>>
                                            <td>
                                                <%= registros2[i].idvuelo%>
                                            </td>
                                            <td>
                                                <%= registros2[i].numerovuelo%>
                                            </td>
                                            <td>
                                                <%= registros2[i].fecha_salida%>
                                            </td>
                                            <td>
                                                <%= registros2[i].aeropuerto_codigoiata_origen%>
                                            </td>
                                            <td>
                                                <%= registros2[i].aeropuerto_codigoiata_destino%>
                                            </td>
                                </tr>
                                <%}%>
                        </tbody>
                    </table>

                </div>
                <%}else{%>
                    <div class="pneg">
                        <p>No se pudo eliminar el aeropuerto.</p> <br>
                        <p>Verifique que el codigo IATA sea correcto o que no tenga vuelos asociados.</p>
                    </div>
                    <%}%>
                        <%}}%>
    </div>

</body>

</html>